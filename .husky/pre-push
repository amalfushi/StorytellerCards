#!/usr/bin/env sh

# Detect changed files compared to remote
UI_CHANGED=$(git diff --name-only @{push}.. -- UI/ 2>/dev/null || git diff --name-only HEAD~1 -- UI/ 2>/dev/null || true)
API_CHANGED=$(git diff --name-only @{push}.. -- API/ 2>/dev/null || git diff --name-only HEAD~1 -- API/ 2>/dev/null || true)

FAILED=0

if [ -n "$UI_CHANGED" ]; then
  echo "🧪 UI changes detected — running tests with coverage..."
  cd UI && npm run test:coverage
  if [ $? -ne 0 ]; then
    echo "❌ Tests/coverage failed"
    FAILED=1
  fi
  cd ..

  # Auto-commit coverage summary if tests passed
  if [ $FAILED -eq 0 ]; then
    # Extract summary from coverage-final.json into a small coverage-summary.json
    node -e "
      const c = require('./UI/coverage/coverage-final.json');
      const s = {statements:{total:0,covered:0},branches:{total:0,covered:0},functions:{total:0,covered:0},lines:{total:0,covered:0}};
      for (const f of Object.values(c)) {
        for (const k of ['s','b','f']) {
          const map = f[k];
          for (const v of Object.values(map)) {
            if (k==='s'){s.statements.total++;if(v>0)s.statements.covered++}
            if (k==='f'){s.functions.total++;if(v>0)s.functions.covered++}
            if (k==='b'){for(const bv of (Array.isArray(v)?v:[v])){s.branches.total++;if(bv>0)s.branches.covered++}}
          }
        }
        const lm=f.statementMap;for(const[k2,v2] of Object.entries(f.s)){s.lines.total++;if(v2>0)s.lines.covered++}
      }
      for(const k of Object.keys(s)){s[k].pct=s[k].total?+(100*s[k].covered/s[k].total).toFixed(2):100}
      require('fs').writeFileSync('UI/coverage/coverage-summary.json',JSON.stringify(s,null,2)+'\n');
    " 2>/dev/null || true
    git add UI/coverage/coverage-summary.json
    git diff --cached --quiet UI/coverage/coverage-summary.json || git commit --no-verify -m "chore: update coverage summary"
  fi
fi

if [ -n "$API_CHANGED" ]; then
  echo "🧪 API changes detected — running Go tests..."
  cd API && go test ./...
  if [ $? -ne 0 ]; then FAILED=1; fi
  cd ..
fi

if [ -z "$UI_CHANGED" ] && [ -z "$API_CHANGED" ]; then
  echo "ℹ️  No UI or API changes to test"
fi

exit $FAILED
